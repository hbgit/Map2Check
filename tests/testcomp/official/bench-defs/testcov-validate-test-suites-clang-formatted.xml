  <resultfiles>**output/**</resultfiles>

  <option name="--memlimit" />
  <option name="6GB" />
  <option name="--timelimit-per-run" />
  <option name="50" />
  <option name="--format" />
  <option name="--verbose" />
  <option name="--no-plots" />
  <option name="--prep-cgroup" />
  <option name="--disable-info-files" />
  <option name="--compiler" />
  <option name="clang" />
  <option name="--cov-tool" />
  <option name="llvm-cov" />
  <option name="--reduction" />
  <option name="BY_ORDER" />
  <option name="--reduction-output" />
  <option name="test-suite" />

