@article{korel1988dynamicslice,
title = {Dynamic slicing of computer programs},
journal = {Journal of Systems and Software},
volume = {13},
number = {3},
pages = {187-195},
year = {1990},
issn = {0164-1212},
doi = {https://doi.org/10.1016/0164-1212(90)90094-3},
url = {https://www.sciencedirect.com/science/article/pii/0164121290900943},
author = {Bogdan Korel and Janusz Laski},
abstract = {Program slicing is a useful tool in program debugging [25, 26]. Dynamic slicing introduced in this paper differs from the original static slicing in that it is defined on the basis of a computation. A dynamic program slice is an executable part of the original program that preserves part of the program's behavior for a specific input with respect to a subset of selected variables, rather than for all possible computations. As a result, the size of a slice can be significantly reduced. Moreover, the approach allows us to treat array elements and fields in dynamic records as individual variables. This leads to a further reduction of the slice size.}
}

